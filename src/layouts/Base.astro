---
import '../styles/global.css';
import RechercheCommune from '../composants/RechercheCommune.astro';

interface Props {
  titre: string;
  description: string;
  /** L'explorateur occupe tout l'écran ; les pages de nœud sont des pages. */
  plein?: boolean;
  /**
   * L'adresse d'un flux Atom que cette page accompagne.
   *
   * Déclarée dans l'en-tête plutôt que seulement dans le corps : c'est ainsi
   * qu'un navigateur et qu'un agrégateur le trouvent sans qu'on ait à coller
   * l'adresse à la main.
   */
  flux?: string;
}
const { titre, description, plein = false, flux } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre} — Rouages</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="fr_FR" />
    {flux && (
      <link rel="alternate" type="application/atom+xml" title={titre} href={flux} />
    )}
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Cg fill='none' stroke='%231e5f74' stroke-width='2.5'%3E%3Ccircle cx='11' cy='12' r='6'/%3E%3Ccircle cx='22' cy='21' r='5'/%3E%3Cpath d='M15 16l3 2'/%3E%3C/g%3E%3C/svg%3E"
    />
  </head>
  <body>
    <header class="bandeau">
      <div class="bandeau-int">
        <a class="marque" href="/">Rouages</a>
        <span class="baseline">qui fait quoi, et avec qui</span>
        <RechercheCommune />
        <nav>
          <a href="/">La carte</a>
          <a href="/etat">Les pouvoirs</a>
          <a href="/glossaire">Glossaire</a>
          <a href="/methode">La méthode</a>
        </nav>
      </div>
    </header>

    <slot />

    {!plein && (
      <footer>
        <p>
          Rouages ne réécrit pas ce que Wikipédia, Légifrance ou l’open data
          disent déjà&nbsp;: il montre les liens entre eux. Ce site n’est ni une
          source de droit, ni un conseil juridique.
        </p>
        <p>
          Contenu sous licence CC BY-SA 4.0, données publiques sous Licence
          Ouverte. Chaque nœud porte sa date de vérification.
          <a href="/mentions">Mentions légales</a>.
        </p>
        <p>
          Une erreur&nbsp;? <a href="/signaler">Signalez-la</a> — les référentiels
          ont des trous, et vous connaissez peut-être votre commune mieux qu’eux.
        </p>
      </footer>
    )}
  </body>
</html>
