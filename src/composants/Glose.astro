---
/**
 * Rend un texte en explicitant ses sigles.
 *
 * `<abbr title>` plutôt qu'une infobulle maison : c'est la balise que les
 * lecteurs d'écran annoncent, elle marche sans JavaScript, et le navigateur
 * l'affiche déjà au survol. Une infobulle dessinée à la main coûterait du code
 * pour faire moins bien.
 */
import { glossaireDuSite } from '../modele/glossaire-du-site.ts';

interface Props {
  texte: string;
}
const { texte } = Astro.props;
const glossaire = glossaireDuSite();
const segments = glossaire.decouper(texte);
---
{segments.map((s) =>
  s.sigle ? (
    <abbr title={s.sigle.definition ? `${s.sigle.developpe} — ${s.sigle.definition}` : s.sigle.developpe}>
      {s.texte}
    </abbr>
  ) : (
    s.texte
  ),
)}
