---
/**
 * La page d'une commune.
 *
 * Jusqu'ici, la partie la plus riche du site — qui exerce quoi chez vous, qui
 * est le maire, ce que sont devenues les écoles — n'existait que derrière
 * `?commune=03165`, en JavaScript. Elle n'avait donc pas d'adresse : on ne
 * pouvait ni la partager, ni l'indexer, ni la lire sans script. Pour un site
 * qui veut centraliser l'information sur le fonctionnement des institutions,
 * c'était le manque le plus coûteux.
 *
 * Cette page est le socle : ce que le site peut affirmer d'une commune sans
 * rien exécuter. La carte reste l'endroit où l'on explore ; ici on arrive, on
 * lit, on repart avec un nom et un lien.
 *
 * Elle ne reprend pas tout — ni les marchés, ni les courbes de finances, ni les
 * droits de mutation : ce sont des lectures, pas des réponses, et la carte les
 * porte déjà. Multiplier leur poids par 34 875 pages coûterait cher pour ce
 * qu'un lecteur venu par un moteur cherche vraiment : qui décide ici.
 */
import Base from '../../layouts/Base.astro';
import { construireReseau } from '../../modele/reseau.ts';
import { communes, ficheCommune, journalCommune, metaTerritoires } from '../../modele/territoires.ts';
import type { Verdict } from '../../modele/verdict.ts';
import { urlSignaler } from '../../modele/signalement.ts';
import Glose from '../../composants/Glose.astro';
import { ARTICLE_DOCUMENT, enFrancais, NOM_DOCUMENT } from '../../modele/urbanisme.ts';

export function getStaticPaths() {
  // `ROUAGES_DEPS` restreint la génération à quelques départements : engendrer
  // les 34 875 communes prend plusieurs minutes, et on ne veut pas les payer à
  // chaque essai de mise en page.
  const filtre = process.env.ROUAGES_DEPS?.split(',').map((d) => d.trim()).filter(Boolean);
  const liste = communes().filter((c) => !filtre || filtre.includes(c.dep));
  return liste.map((c) => ({ params: { code: c.code }, props: { commune: c } }));
}

const { commune } = Astro.props;
const reseau = construireReseau();
const meta = metaTerritoires();

// Le contenu décide de ce qu'on cherche à savoir : on résout les compétences
// que le réseau déclare résolubles, pas tous les codes du référentiel.
const resolubles = reseau.noeuds
  .filter((n) => n.banatic && n.banatic.length > 0)
  .map((n) => ({ id: n.id, banatic: n.banatic! }));
const fiche = ficheCommune(commune, resolubles);

const nomDe = new Map(reseau.noeuds.map((n) => [n.id, n]));
/**
 * Le verdict en deux morceaux : qui, et une incise qui dit d'où vient la
 * réponse.
 *
 * La nature juridique de chaque structure n'est pas répétée ici : elle figure
 * une fois, plus haut, dans la liste des structures. La redire à chaque ligne
 * alourdissait la page d'un bon kilo-octet — multiplié par 34 875 — pour une
 * information déjà donnée.
 */
function direVerdict(v: Verdict): { qui: string; incise: string | null; etat: string } {
  switch (v.etat) {
    case 'transferee':
      return { qui: v.structures.map((s) => s.nom).join(' · '), incise: null, etat: v.etat };
    case 'transferee-par-loi':
      return {
        qui: v.structures.map((s) => s.nom).join(' · '),
        incise: 'transfert prévu de plein droit par la loi',
        etat: v.etat,
      };
    case 'a-defaut':
      return { qui: v.qui, incise: "à défaut d'intercommunalité, par la loi", etat: v.etat };
    case 'communale':
      return { qui: 'la commune', incise: 'aucun transfert enregistré', etat: v.etat };
    case 'non-renseigne':
      return {
        qui: 'non renseigné ici',
        incise:
          `${Math.round(v.couvertureDep * 100)} % des communes du département ont un exerçant ` +
          `identifié, contre ${Math.round(v.couvertureNationale * 100)} % en France`,
        etat: v.etat,
      };
  }
}

const lignes = fiche
  ? [...fiche.verdicts.entries()]
      .map(([id, v]) => ({
        noeud: nomDe.get(id)!,
        dit: direVerdict(v),
        reserve: fiche.reserve(id),
      }))
      .filter((l) => l.noeud)
      .sort((a, b) => a.noeud.nom.localeCompare(b.noeud.nom, 'fr'))
  : [];

const LIBELLE_FAMILLE: Record<string, string> = {
  ecole: 'Écoles',
  college: 'Collèges',
  lycee: 'Lycées',
  'france-services': 'France services',
  ccas: 'Action sociale',
  sante: 'Santé',
  'point-justice': 'Points-justice',
};
/**
 * Le chiffre d'une école, calculé ici plutôt que dans le gabarit : la dernière
 * rentrée renseignée demande un parcours de la série, et une expression de ce
 * genre au milieu du balisage se relit mal.
 */
function chiffresEcole(e?: { classes: (number | null)[]; eleves: (number | null)[]; rentrees: number[] }) {
  if (!e) return null;
  const i = e.classes.reduce<number>((k, v, j) => (v !== null ? j : k), -1);
  if (i === -1) return null;
  const classes = e.classes[i]!;
  const eleves = e.eleves[i];
  return (
    `${classes} classe${classes > 1 ? 's' : ''}` +
    (eleves !== null && eleves !== undefined ? ` · ${eleves} élèves` : '') +
    ` en ${e.rentrees[i]}`
  );
}

interface ServiceAffiche {
  nom: string;
  prive: boolean;
  chiffres: string | null;
}
/**
 * Qui écrit la règle de ce qui peut se construire, en une phrase.
 *
 * Trois situations, qui n'ont pas les mêmes conséquences pour un habitant :
 * un plan voté par le conseil municipal, un plan voté ailleurs, ou pas de
 * plan du tout — auquel cas le préfet donne son accord sur chaque permis.
 */
const urb = fiche?.urbanisme ?? null;
const phraseUrbanisme = !urb
  ? ''
  : urb.document === 'RNU'
    ? 'Aucun document d’urbanisme local : c’est le règlement national d’urbanisme qui s’applique ' +
      'ici. Une construction n’y est en principe autorisée que dans les parties déjà urbanisées ' +
      'de la commune (article L111-3 du code de l’urbanisme), et le maire ne peut délivrer un ' +
      'permis qu’avec l’accord du préfet — un avis conforme, c’est-à-dire qu’un avis défavorable ' +
      'l’interdit (article L422-5).'
    : `La commune est couverte par ${ARTICLE_DOCUMENT[urb.document] ?? 'un'} ` +
      `${NOM_DOCUMENT[urb.document] ?? urb.document}` +
      (urb.approuve ? `, approuvé le ${enFrancais(urb.approuve)}` : '') +
      '. ' +
      (urb.qui === 'groupement'
        ? urb.porteur
          ? `Il est porté par ${urb.porteur} : ses règles sont votées par le conseil de ce ` +
            `groupement, non par le conseil municipal.`
          : 'Il est porté par l’intercommunalité, non par le conseil municipal.'
        : urb.qui === 'transferee'
          ? `Ce plan ne couvre que la commune, mais la compétence en urbanisme appartient ` +
            `désormais à ${urb.porteur ?? 'son intercommunalité'} : c’est son conseil qui en ` +
            `votera la révision.`
          : 'Il est voté par le conseil municipal.');

/**
 * Ce qu'on trouve sur place, et ce pour quoi il faut partir.
 *
 * Les absences sont bornées : une commune de deux cents habitants en compte
 * vingt-six, et une phrase de vingt-six éléments ne se lit pas. Le panneau,
 * lui, les donne toutes — il a la place d'une liste.
 */
const ABSENTS_MONTRES = 10;
const equ = fiche?.equipements ?? null;

/** Ce qui est prélevé ici, et par qui. */
const fisc = fiche?.fiscalite ?? null;
const pourCent = (v: number) =>
  `${v.toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} %`;

/** Ce qui sort du plan : autorisé, commencé, et la part des maisons. */
const log = fiche?.logements ?? null;
const dixieme = (v: number) =>
  v.toLocaleString('fr-FR', { minimumFractionDigits: 1, maximumFractionDigits: 1 });

const parFamille = new Map<string, ServiceAffiche[]>();
for (const s of fiche?.services ?? []) {
  if (!parFamille.has(s.famille)) parFamille.set(s.famille, []);
  parFamille.get(s.famille)!.push({ nom: s.nom, prive: s.prive, chiffres: chiffresEcole(s.ecole) });
}

/**
 * Ce qui a bougé, en six lignes.
 *
 * Six et non douze, pour la raison qui écarte déjà les marchés et les courbes
 * de cette page : ce qu'on y ajoute se multiplie par 34 875. La section pèse
 * alors deux kilo-octets au lieu de quatre, soit soixante-dix méga-octets de
 * moins sur le site entier — et la suite est dans le flux, vers lequel elle
 * conduit.
 */
const journal = journalCommune(commune, 6);

const region = meta?.regions?.[commune.dep];
const titre = `${commune.nom} — qui décide quoi`;
const description = fiche
  ? `Qui exerce chaque compétence à ${commune.nom} (${commune.cp}) : intercommunalité, ` +
    `syndicats, commune. Écoles, services publics et interlocuteurs, avec leurs sources.`
  : `${commune.nom} (${commune.cp})`;

/** « 2026-03-20 » devient « mars 2026 ». */
function moisAnnee(iso: string): string | null {
  const d = new Date(iso);
  return Number.isNaN(d.getTime())
    ? null
    : d.toLocaleDateString('fr-FR', { month: 'long', year: 'numeric' });
}
---

<Base
  titre={titre}
  description={description}
  flux={journal.length > 0 ? `/commune/${commune.code}-flux.xml` : undefined}
>
  <div class="page page--etroite">
    <p class="badge">Commune · {commune.depNom}{region ? ` · ${region}` : ''}</p>
    <h1>{commune.nom}</h1>
    <p class="resume">
      {commune.population.toLocaleString('fr-FR')} habitants · code postal {commune.cp} ·
      code INSEE {commune.code}
    </p>
    {fiche?.sommet && fiche.sommet.ecart < 0 && (
      <p class="c-sommet">
        La commune a compté jusqu’à <strong>{fiche.sommet.valeur.toLocaleString('fr-FR')} habitants
        en {fiche.sommet.annee}</strong> — elle en a {Math.abs(fiche.sommet.ecart)} % de moins
        aujourd’hui. Tous les montants de cette page étant rapportés à l’habitant, c’est ce
        dénominateur-là qui bouge sous eux.
      </p>
    )}

    {!fiche && (
      <p class="c-vide">
        Les données territoriales de cette commune n’ont pas pu être assemblées.
        La carte reste le meilleur endroit d’où repartir.
      </p>
    )}

    {fiche?.maire && (
      <p class="p-maire">
        <span class="p-maire-fonction">Maire</span>
        <span class="p-maire-nom">{fiche.maire.prenom} {fiche.maire.nom}</span>
        {moisAnnee(fiche.maire.depuis) && (
          <span class="p-maire-depuis">mandat en cours depuis {moisAnnee(fiche.maire.depuis)}</span>
        )}
      </p>
    )}

    {fiche?.conseil && fiche.conseil.sieges > 0 && (
      <p class="c-conseil">
        <strong>{fiche.conseil.sieges} sièges</strong> au conseil municipal{fiche.conseil.siegesCc > 0 && (
          <>{', et '}<strong>{fiche.conseil.siegesCc}</strong>{' au conseil '}{fiche.conseil.ou
            ? <Glose texte={`de ${fiche.conseil.ou}`} />
            : <>communautaire</>}</>
        )}.{' '}
        <span class="c-conseil-source">D’après les résultats des {fiche.conseil.scrutin}.</span>
        {fiche.conseil.elus > 0 && (
          <span class="c-conseil-compo">
            {'Le conseil compte aujourd’hui '}<strong>{fiche.conseil.elus} élus</strong>{
              fiche.conseil.elus < fiche.conseil.sieges
                ? ` — ${fiche.conseil.sieges - fiche.conseil.elus} siège${fiche.conseil.sieges - fiche.conseil.elus > 1 ? 's' : ''} vacant${fiche.conseil.sieges - fiche.conseil.elus > 1 ? 's' : ''}`
                : ''
            }{', dont '}<strong>{Math.round((fiche.conseil.femmes / fiche.conseil.elus) * 100)} % de femmes</strong>{
              ` (contre ${fiche.conseil.femmesPartout.toLocaleString('fr-FR')} % dans l’ensemble des conseils), d’un âge médian de `
            }<strong>{fiche.conseil.ageMedian} ans</strong>{` (contre ${fiche.conseil.agePartout}).`}
            {fiche.conseil.ageMax > fiche.conseil.ageMin && (
              <>{` Du plus jeune, ${fiche.conseil.ageMin} ans, au plus âgé, ${fiche.conseil.ageMax} ans.`}</>
            )}
            {fiche.conseil.groupes.length > 0 && (
              <>{' Par groupe socioprofessionnel : '}{fiche.conseil.groupes
                .map((g) => `${g.nombre} ${g.nom.toLowerCase()}`)
                .join(', ')}.</>
            )}
          </span>
        )}
        {fiche.conseil.designes && fiche.conseil.ou && (
          <span class="c-conseil-designes">
            Au conseil de <Glose texte={fiche.conseil.ou} />, la commune n’élit pas ses
            représentants&nbsp;: sous mille habitants, ce sont les conseillers municipaux pris
            dans l’ordre du tableau — le maire, puis les adjoints (article L273-11 du code
            électoral). Le résultat du scrutin ne les nomme donc pas.
          </span>
        )}
      </p>
    )}

    {fiche && fiche.structures.length > 0 && (
      <section>
        <h2 class="badge">Les structures dont elle dépend</h2>
        <ul class="c-structures">
          {fiche.structures.map((s) => (
            <li>
              <strong><Glose texte={s.nom} /></strong>
              <span class="v-nature">{s.natureLibelle}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {lignes.length > 0 && (
      <section>
        <h2 class="badge">Qui exerce quoi, ici</h2>
        <dl class="c-verdicts">
          {lignes.map((l) => (
            <div>
              <dt><a href={`/n/${l.noeud.id}`}><Glose texte={l.noeud.court} /></a></dt>
              <dd>
                <span class={`c-verdict c-verdict--${l.dit.etat}`}><Glose texte={l.dit.qui} /></span>
                {l.dit.incise && <span class="c-incise">{l.dit.incise}</span>}
                {l.reserve && <span class="c-reserve">{l.reserve}</span>}
              </dd>
            </div>
          ))}
        </dl>
        <p class="p-source-territoire">
          D’après les transferts de compétences déclarés à BANATIC ({fiche!.maj}). Une compétence
          exercée sans transfert déclaré — par convention, par exemple — n’y figure pas.
        </p>
      </section>
    )}

    {fisc && (
      <section>
        <h2 class="badge">Ce qui est prélevé ici</h2>
        <p class="c-fiscalite">
          {`Taxe foncière sur le bâti ${fisc.millesime} : `}
          <strong>{pourCent(fisc.fbTotal)}</strong>
          {` — médiane des communes ${pourCent(fisc.medianeFb)}. Ce taux additionne ` +
            fisc.fb.map((p) => `${pourCent(p.taux)} (${p.nom.toLowerCase()})`).join(', ') +
            '.'}
          <span class="c-fiscalite-suite">
            {(fisc.omTaux > 0 && fisc.omQui
              ? `Ordures ménagères : ${pourCent(fisc.omTaux)}, perçus par ${fisc.omQui}. `
              : 'Aucune taxe d’enlèvement des ordures ménagères : le service est financé par une ' +
                'redevance ou sur le budget général. ') +
              (fisc.thTotal > 0
                ? `Résidences secondaires : ${pourCent(fisc.thTotal)} de taxe d’habitation, dont ` +
                  `${pourCent(fisc.thCommune)} pour la commune` +
                  (fisc.majoration > 0
                    ? `, majorés de ${fisc.majoration.toLocaleString('fr-FR')} %`
                    : '') +
                  '. '
                : '') +
              (fisc.cfeGroupement > 0
                ? `Entreprises : ${pourCent(fisc.cfeGroupement)} de cotisation foncière, votés par ` +
                  'l’intercommunalité.'
                : fisc.cfeCommune > 0
                  ? `Entreprises : ${pourCent(fisc.cfeCommune)} de cotisation foncière, votés par ` +
                    'le conseil municipal.'
                  : '')}
          </span>
          <span class="c-fiscalite-source">
            {`D’après le recensement des éléments d’imposition de la DGFiP, millésime ` +
              `${fisc.millesime} (${fisc.maj}). Le taux communal de taxe foncière a absorbé en ` +
              '2021 l’ancienne part départementale. Le montant dû dépend aussi de la valeur ' +
              'locative du bien, que ce site ne connaît pas.'}
          </span>
        </p>
      </section>
    )}

    {urb && (
      <section>
        <h2 class="badge">Ce qui peut s’y construire</h2>
        <p class="c-urbanisme">{phraseUrbanisme}</p>
        {urb.enCours && (
          <p class="c-urbanisme-en-cours">
            {`Une procédure est en cours : ${ARTICLE_DOCUMENT[urb.enCours.document] ?? 'un'} ` +
              `${NOM_DOCUMENT[urb.enCours.document] ?? urb.enCours.document}, ` +
              `prescrit${urb.enCours.document === 'CC' ? 'e' : ''} le ` +
              `${enFrancais(urb.enCours.prescrit)}.`}
            <span class="c-urbanisme-prise">
              C’est pendant une telle procédure, et à l’enquête publique qui la clôt, que l’avis
              d’un habitant a encore prise sur le texte.
            </span>
          </p>
        )}
        {urb.totalPartout > 0 && (
          <p class="c-urbanisme-repere">
            {`Sur les ${urb.totalPartout.toLocaleString('fr-FR')} communes du pays, ` +
              `${urb.sansDocumentPartout.toLocaleString('fr-FR')} n’ont aucun document local ` +
              `(${Math.round((urb.sansDocumentPartout / urb.totalPartout) * 100)} %) et ` +
              `${urb.intercommunalesPartout.toLocaleString('fr-FR')} relèvent d’une règle ` +
              `intercommunale (${Math.round((urb.intercommunalesPartout / urb.totalPartout) * 100)} %).`}
          </p>
        )}
        {log && (
          <p class="c-logements">
            {`En ${log.annees.length} ans, de ${log.annees[0]} à ${log.annees[log.annees.length - 1]}, `}
            <strong>{`${log.autorises.toLocaleString('fr-FR')} logement${log.autorises > 1 ? 's' : ''} autorisé${log.autorises > 1 ? 's' : ''}`}</strong>
            {` — ${dixieme(log.taux)} pour 1 000 habitants, contre ${dixieme(log.medianeTaux)} à la ` +
              'médiane des communes. ' +
              (log.commences === 0
                ? 'Aucun n’a été commencé.'
                : `${log.commences.toLocaleString('fr-FR')} ${log.commences > 1 ? 'ont' : 'a'} ` +
                  `été commencé${log.commences > 1 ? 's' : ''}.`) +
              (log.autorises === 0 || log.individuels === 0
                ? ''
                : ` ${log.individuels.toLocaleString('fr-FR')} des autorisations ` +
                  `${log.individuels > 1 ? 'portent' : 'porte'} sur une maison individuelle.`)}
            <span class="c-logements-source">
              {`D’après Sitadel (${log.maj}), arrêté à ${moisAnnee(log.arrete) ?? log.arrete}. Ce ` +
                'sont des logements et non des permis, en date de prise en compte de ' +
                'l’autorisation et non de signature.'}
            </span>
          </p>
        )}
        <p class="p-source-territoire">
          {`D’après l’enquête annuelle SuDocUH du ministère chargé de l’urbanisme (${urb.maj})` +
            (urb.jusquau
              ? `, qui connaît les approbations jusqu’au ${enFrancais(urb.jusquau)} : un document ` +
                `approuvé depuis n’y figure pas encore`
              : '') +
            '. Le document lui-même — son règlement, son zonage, le plan de la parcelle — se ' +
            'consulte en mairie, et le plus souvent sur le Géoportail de l’urbanisme.'}
        </p>
      </section>
    )}

    {equ && (
      <section>
        <h2 class="badge">Ce qu’on trouve sur place</h2>
        <p class="c-equipements">
          <strong>{`${equ.proximite} des ${equ.proximiteTotal} équipements de proximité`}</strong>
          {` que recense l’INSEE en ${equ.millesime} — médiane des communes : ` +
            `${equ.medianeProximite}. Les plus nombreux : ` +
            equ.principaux
              .map((x) => `${x.nom} (${x.nombre.toLocaleString('fr-FR')})`)
              .join(', ') + '.'}
          {equ.absents.length > 0 && (
            <span class="c-equipements-absents">
              {'Absents de la gamme de proximité : ' +
                equ.absents
                  .slice(0, ABSENTS_MONTRES)
                  .map((n) => n.replace(/, ([^,]*)$/, ' ou $1'))
                  .join(' ; ') +
                (equ.absents.length > ABSENTS_MONTRES
                  ? `, et ${equ.absents.length - ABSENTS_MONTRES} autres.`
                  : '.')}
            </span>
          )}
          <span class="c-equipements-source">
            {`D’après la base permanente des équipements (${equ.maj}). La gamme de proximité est ` +
              'celle que l’INSEE publie, non une liste établie ici ; ce sont des équipements ' +
              'ouverts au public, marchands compris. Une commune sans équipement n’est pas une ' +
              'commune sans accès : le bourg voisin est parfois à trois kilomètres.'}
          </span>
        </p>
      </section>
    )}

    {parFamille.size > 0 && (
      <section>
        <h2 class="badge">Les services publics sur place</h2>
        {[...parFamille].map(([famille, liste]) => (
          <div class="c-famille">
            <h3>{LIBELLE_FAMILLE[famille] ?? famille}</h3>
            <ul>
              {liste.map((s) => (
                <li>
                  {s.nom}
                  {s.prive && <span class="p-service-note">privé</span>}
                  {s.chiffres && <span class="p-ecole-chiffres">{s.chiffres}</span>}
                </li>
              ))}
            </ul>
          </div>
        ))}
        {Object.entries(fiche?.voisines ?? {}).map(([famille, v]) => (
          !parFamille.has(famille) && (
            <p class="p-service-voisin">
              <span class="p-service-famille">{LIBELLE_FAMILLE[famille] ?? famille}</span>
              <span>
                aucun dans la commune.{' '}
                {v.l.length > 0
                  ? `Dans son intercommunalité : ${v.l.join(', ')}.`
                  : `${v.n} communes de son intercommunalité en accueillent un.`}
              </span>
            </p>
          )
        ))}
        {fiche?.sdis && <p class="p-source-territoire">Secours : {fiche.sdis}.</p>}
      </section>
    )}

    {fiche?.risques && (fiche.risques.recenses.length > 0 || fiche.risques.catnat.length > 0) && (
      <section>
        <h2 class="badge">À quoi la commune est exposée</h2>
        {fiche.risques.recenses.length > 0 && (
          <p class="mesure">
            <strong>Recensés au dossier départemental</strong>&nbsp;:
            {' '}{fiche.risques.recenses
              .map((r) => (r.sous.length > 0 ? `${r.nom} (${r.sous.map((x) => x.charAt(0).toLowerCase() + x.slice(1)).join(', ')})` : r.nom))
              .join(', ')}.
          </p>
        )}
        {fiche.risques.catnat.length > 0 && (
          <p class="mesure">
            <strong>Reconnaissances de catastrophe naturelle depuis 1982</strong>&nbsp;:
            {' '}{fiche.risques.catnat
              .map((c) => {
                // « dernier en » n'a de sens qu'au-delà d'un arrêté : sinon
                // c'est le seul, et « dernier » laisserait croire à une série.
                const quand = c.dernier ? `${c.nombre > 1 ? ', dernier en ' : ', en '}${c.dernier.slice(0, 4)}` : '';
                return `${c.nom.toLowerCase()} (${c.nombre}${quand})`;
              })
              .join(', ')}.
          </p>
        )}
        {fiche.risques.plans.length > 0 && (
          <p class="mesure">
            <strong>Plans de prévention</strong>&nbsp;:
            {' '}{fiche.risques.plans
              .map((p) => `${p.nom}${p.etat ? ` (${p.etat.toLowerCase()}${p.date ? `, ${p.date.slice(0, 4)}` : ''})` : ''}`)
              .join(' ; ')}.
          </p>
        )}
        <p class="p-source-territoire">
          D’après GASPAR, la base du ministère de la Transition écologique ({fiche.risques.maj}).
          Les risques recensés et les catastrophes reconnues sont deux listes distinctes&nbsp;: la
          première dit ce à quoi l’État estime la commune exposée, la seconde ce qui est arrivé.
          {fiche.risques.dicrim
            ? ` Document d’information communal publié en ${fiche.risques.dicrim}.`
            : ' Aucun document d’information communal recensé.'}
        </p>
      </section>
    )}

    {journal.length > 0 && (
      <section class="releve">
        <h2 class="badge">Ce qui a bougé récemment</h2>
        <p class="mesure">
          Les six derniers faits datés — ici et dans les structures dont la commune dépend,
          qui agissent le plus souvent pour elle.
          {' '}<a href={`/commune/${commune.code}-flux.xml`}>S’abonner au flux</a>, pour le
          recevoir dans un agrégateur. Le site ne demande aucune adresse et n’en conserve aucune.
        </p>
        <ul class="journal">
          {journal.map((e) => (
            <li>
              <span class="journal-date">{e.date}</span>
              <span class="journal-fait">
                <span class="journal-genre">{e.genre}</span>
                {e.url ? <a href={e.url}>{e.quoi}</a> : <span>{e.quoi}</span>}
                {(e.par || e.detail) && (
                  <span class="journal-detail">{[e.par, e.detail].filter(Boolean).join(' · ')}</span>
                )}
              </span>
            </li>
          ))}
        </ul>
        <p class="p-source-territoire">
          Le journal ne dit pas tout&nbsp;: un transfert de compétence n’y figure pas, parce que
          le registre BANATIC ne le date pas. Un acte publié tardivement s’y range à sa date, pas
          à celle de sa publication.
        </p>
      </section>
    )}

    <h2 class="badge">Aller plus loin</h2>
    <ul>
      <li>
        <a href={`/?commune=${commune.code}`}>Ouvrir cette commune dans la carte</a> — les
        comptes, les marchés publics, les droits de mutation et les courbes s’y trouvent.
      </li>
      {fiche?.soumiseSru && (
        <li><a href="/n/logement-social">L’obligation de logements sociaux</a> s’applique ici.</li>
      )}
      {fiche?.risques && (
        <li><a href="/n/s-informer-sur-les-risques">S’informer sur les risques de son adresse</a> — ce
        qu’un vendeur doit dire, et ce qui s’ouvre après un arrêté de catastrophe naturelle.</li>
      )}
      <li><a href="/methode">Comment ces réponses sont construites</a></li>
      <li><a href={urlSignaler(undefined, commune.code, `/commune/${commune.code}`)}>Signaler une erreur sur cette commune</a></li>
    </ul>
  </div>
</Base>
