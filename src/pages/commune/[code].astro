---
/**
 * La page d'une commune.
 *
 * Jusqu'ici, la partie la plus riche du site — qui exerce quoi chez vous, qui
 * est le maire, ce que sont devenues les écoles — n'existait que derrière
 * `?commune=03165`, en JavaScript. Elle n'avait donc pas d'adresse : on ne
 * pouvait ni la partager, ni l'indexer, ni la lire sans script. Pour un site
 * qui veut centraliser l'information sur le fonctionnement des institutions,
 * c'était le manque le plus coûteux.
 *
 * Cette page est le socle : ce que le site peut affirmer d'une commune sans
 * rien exécuter. La carte reste l'endroit où l'on explore ; ici on arrive, on
 * lit, on repart avec un nom et un lien.
 *
 * Elle ne reprend pas tout — ni les marchés, ni les courbes de finances, ni les
 * droits de mutation : ce sont des lectures, pas des réponses, et la carte les
 * porte déjà. Multiplier leur poids par 34 875 pages coûterait cher pour ce
 * qu'un lecteur venu par un moteur cherche vraiment : qui décide ici.
 */
import Base from '../../layouts/Base.astro';
import { construireReseau } from '../../modele/reseau.ts';
import { communes, ficheCommune, metaTerritoires } from '../../modele/territoires.ts';
import type { Verdict } from '../../modele/verdict.ts';
import { urlSignaler } from '../../modele/signalement.ts';
import Glose from '../../composants/Glose.astro';

export function getStaticPaths() {
  // `ROUAGES_DEPS` restreint la génération à quelques départements : engendrer
  // les 34 875 communes prend plusieurs minutes, et on ne veut pas les payer à
  // chaque essai de mise en page.
  const filtre = process.env.ROUAGES_DEPS?.split(',').map((d) => d.trim()).filter(Boolean);
  const liste = communes().filter((c) => !filtre || filtre.includes(c.dep));
  return liste.map((c) => ({ params: { code: c.code }, props: { commune: c } }));
}

const { commune } = Astro.props;
const reseau = construireReseau();
const meta = metaTerritoires();

// Le contenu décide de ce qu'on cherche à savoir : on résout les compétences
// que le réseau déclare résolubles, pas tous les codes du référentiel.
const resolubles = reseau.noeuds
  .filter((n) => n.banatic && n.banatic.length > 0)
  .map((n) => ({ id: n.id, banatic: n.banatic! }));
const fiche = ficheCommune(commune, resolubles);

const nomDe = new Map(reseau.noeuds.map((n) => [n.id, n]));
/**
 * Le verdict en deux morceaux : qui, et une incise qui dit d'où vient la
 * réponse.
 *
 * La nature juridique de chaque structure n'est pas répétée ici : elle figure
 * une fois, plus haut, dans la liste des structures. La redire à chaque ligne
 * alourdissait la page d'un bon kilo-octet — multiplié par 34 875 — pour une
 * information déjà donnée.
 */
function direVerdict(v: Verdict): { qui: string; incise: string | null; etat: string } {
  switch (v.etat) {
    case 'transferee':
      return { qui: v.structures.map((s) => s.nom).join(' · '), incise: null, etat: v.etat };
    case 'transferee-par-loi':
      return {
        qui: v.structures.map((s) => s.nom).join(' · '),
        incise: 'transfert prévu de plein droit par la loi',
        etat: v.etat,
      };
    case 'a-defaut':
      return { qui: v.qui, incise: "à défaut d'intercommunalité, par la loi", etat: v.etat };
    case 'communale':
      return { qui: 'la commune', incise: 'aucun transfert enregistré', etat: v.etat };
    case 'non-renseigne':
      return {
        qui: 'non renseigné ici',
        incise:
          `${Math.round(v.couvertureDep * 100)} % des communes du département ont un exerçant ` +
          `identifié, contre ${Math.round(v.couvertureNationale * 100)} % en France`,
        etat: v.etat,
      };
  }
}

const lignes = fiche
  ? [...fiche.verdicts.entries()]
      .map(([id, v]) => ({
        noeud: nomDe.get(id)!,
        dit: direVerdict(v),
        reserve: fiche.reserve(id),
      }))
      .filter((l) => l.noeud)
      .sort((a, b) => a.noeud.nom.localeCompare(b.noeud.nom, 'fr'))
  : [];

const LIBELLE_FAMILLE: Record<string, string> = {
  ecole: 'Écoles',
  college: 'Collèges',
  lycee: 'Lycées',
  'france-services': 'France services',
  ccas: 'Action sociale',
  sante: 'Santé',
  'point-justice': 'Points-justice',
};
/**
 * Le chiffre d'une école, calculé ici plutôt que dans le gabarit : la dernière
 * rentrée renseignée demande un parcours de la série, et une expression de ce
 * genre au milieu du balisage se relit mal.
 */
function chiffresEcole(e?: { classes: (number | null)[]; eleves: (number | null)[]; rentrees: number[] }) {
  if (!e) return null;
  const i = e.classes.reduce<number>((k, v, j) => (v !== null ? j : k), -1);
  if (i === -1) return null;
  const classes = e.classes[i]!;
  const eleves = e.eleves[i];
  return (
    `${classes} classe${classes > 1 ? 's' : ''}` +
    (eleves !== null && eleves !== undefined ? ` · ${eleves} élèves` : '') +
    ` en ${e.rentrees[i]}`
  );
}

interface ServiceAffiche {
  nom: string;
  prive: boolean;
  chiffres: string | null;
}
const parFamille = new Map<string, ServiceAffiche[]>();
for (const s of fiche?.services ?? []) {
  if (!parFamille.has(s.famille)) parFamille.set(s.famille, []);
  parFamille.get(s.famille)!.push({ nom: s.nom, prive: s.prive, chiffres: chiffresEcole(s.ecole) });
}

const region = meta?.regions?.[commune.dep];
const titre = `${commune.nom} — qui décide quoi`;
const description = fiche
  ? `Qui exerce chaque compétence à ${commune.nom} (${commune.cp}) : intercommunalité, ` +
    `syndicats, commune. Écoles, services publics et interlocuteurs, avec leurs sources.`
  : `${commune.nom} (${commune.cp})`;

/** « 2026-03-20 » devient « mars 2026 ». */
function moisAnnee(iso: string): string | null {
  const d = new Date(iso);
  return Number.isNaN(d.getTime())
    ? null
    : d.toLocaleDateString('fr-FR', { month: 'long', year: 'numeric' });
}
---

<Base titre={titre} description={description}>
  <div class="page page--etroite">
    <p class="badge">Commune · {commune.depNom}{region ? ` · ${region}` : ''}</p>
    <h1>{commune.nom}</h1>
    <p class="resume">
      {commune.population.toLocaleString('fr-FR')} habitants · code postal {commune.cp} ·
      code INSEE {commune.code}
    </p>

    {!fiche && (
      <p class="c-vide">
        Les données territoriales de cette commune n’ont pas pu être assemblées.
        La carte reste le meilleur endroit d’où repartir.
      </p>
    )}

    {fiche?.maire && (
      <p class="p-maire">
        <span class="p-maire-fonction">Maire</span>
        <span class="p-maire-nom">{fiche.maire.prenom} {fiche.maire.nom}</span>
        {moisAnnee(fiche.maire.depuis) && (
          <span class="p-maire-depuis">en fonction depuis {moisAnnee(fiche.maire.depuis)}</span>
        )}
      </p>
    )}

    {fiche && fiche.structures.length > 0 && (
      <section>
        <h2 class="badge">Les structures dont elle dépend</h2>
        <ul class="c-structures">
          {fiche.structures.map((s) => (
            <li>
              <strong><Glose texte={s.nom} /></strong>
              <span class="v-nature">{s.natureLibelle}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {lignes.length > 0 && (
      <section>
        <h2 class="badge">Qui exerce quoi, ici</h2>
        <dl class="c-verdicts">
          {lignes.map((l) => (
            <div>
              <dt><a href={`/n/${l.noeud.id}`}><Glose texte={l.noeud.court} /></a></dt>
              <dd>
                <span class={`c-verdict c-verdict--${l.dit.etat}`}><Glose texte={l.dit.qui} /></span>
                {l.dit.incise && <span class="c-incise">{l.dit.incise}</span>}
                {l.reserve && <span class="c-reserve">{l.reserve}</span>}
              </dd>
            </div>
          ))}
        </dl>
        <p class="p-source-territoire">
          D’après les transferts de compétences déclarés à BANATIC ({fiche!.maj}). Une compétence
          exercée sans transfert déclaré — par convention, par exemple — n’y figure pas.
        </p>
      </section>
    )}

    {parFamille.size > 0 && (
      <section>
        <h2 class="badge">Les services publics sur place</h2>
        {[...parFamille].map(([famille, liste]) => (
          <div class="c-famille">
            <h3>{LIBELLE_FAMILLE[famille] ?? famille}</h3>
            <ul>
              {liste.map((s) => (
                <li>
                  {s.nom}
                  {s.prive && <span class="p-service-note">privé</span>}
                  {s.chiffres && <span class="p-ecole-chiffres">{s.chiffres}</span>}
                </li>
              ))}
            </ul>
          </div>
        ))}
        {Object.entries(fiche?.voisines ?? {}).map(([famille, v]) => (
          !parFamille.has(famille) && (
            <p class="p-service-voisin">
              <span class="p-service-famille">{LIBELLE_FAMILLE[famille] ?? famille}</span>
              <span>
                aucun dans la commune.{' '}
                {v.l.length > 0
                  ? `Dans son intercommunalité : ${v.l.join(', ')}.`
                  : `${v.n} communes de son intercommunalité en accueillent un.`}
              </span>
            </p>
          )
        ))}
        {fiche?.sdis && <p class="p-source-territoire">Secours : {fiche.sdis}.</p>}
      </section>
    )}

    {fiche?.risques && (fiche.risques.recenses.length > 0 || fiche.risques.catnat.length > 0) && (
      <section>
        <h2 class="badge">À quoi la commune est exposée</h2>
        {fiche.risques.recenses.length > 0 && (
          <p class="mesure">
            <strong>Recensés au dossier départemental</strong>&nbsp;:
            {' '}{fiche.risques.recenses
              .map((r) => (r.sous.length > 0 ? `${r.nom} (${r.sous.map((x) => x.charAt(0).toLowerCase() + x.slice(1)).join(', ')})` : r.nom))
              .join(', ')}.
          </p>
        )}
        {fiche.risques.catnat.length > 0 && (
          <p class="mesure">
            <strong>Reconnaissances de catastrophe naturelle depuis 1982</strong>&nbsp;:
            {' '}{fiche.risques.catnat
              .map((c) => {
                // « dernier en » n'a de sens qu'au-delà d'un arrêté : sinon
                // c'est le seul, et « dernier » laisserait croire à une série.
                const quand = c.dernier ? `${c.nombre > 1 ? ', dernier en ' : ', en '}${c.dernier.slice(0, 4)}` : '';
                return `${c.nom.toLowerCase()} (${c.nombre}${quand})`;
              })
              .join(', ')}.
          </p>
        )}
        {fiche.risques.plans.length > 0 && (
          <p class="mesure">
            <strong>Plans de prévention</strong>&nbsp;:
            {' '}{fiche.risques.plans
              .map((p) => `${p.nom}${p.etat ? ` (${p.etat.toLowerCase()}${p.date ? `, ${p.date.slice(0, 4)}` : ''})` : ''}`)
              .join(' ; ')}.
          </p>
        )}
        <p class="p-source-territoire">
          D’après GASPAR, la base du ministère de la Transition écologique ({fiche.risques.maj}).
          Les risques recensés et les catastrophes reconnues sont deux listes distinctes&nbsp;: la
          première dit ce à quoi l’État estime la commune exposée, la seconde ce qui est arrivé.
          {fiche.risques.dicrim
            ? ` Document d’information communal publié en ${fiche.risques.dicrim}.`
            : ' Aucun document d’information communal recensé.'}
        </p>
      </section>
    )}

    <h2 class="badge">Aller plus loin</h2>
    <ul>
      <li>
        <a href={`/?commune=${commune.code}`}>Ouvrir cette commune dans la carte</a> — les
        comptes, les marchés publics, les droits de mutation et les courbes s’y trouvent.
      </li>
      {fiche?.soumiseSru && (
        <li><a href="/n/logement-social">L’obligation de logements sociaux</a> s’applique ici.</li>
      )}
      {fiche?.risques && (
        <li><a href="/n/s-informer-sur-les-risques">S’informer sur les risques de son adresse</a> — ce
        qu’un vendeur doit dire, et ce qui s’ouvre après un arrêté de catastrophe naturelle.</li>
      )}
      <li><a href="/methode">Comment ces réponses sont construites</a></li>
      <li><a href={urlSignaler(undefined, commune.code, `/commune/${commune.code}`)}>Signaler une erreur sur cette commune</a></li>
    </ul>
  </div>
</Base>
