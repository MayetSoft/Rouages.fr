---
import Base from '../layouts/Base.astro';
import { construireReseau } from '../modele/reseau.ts';
import { LIBELLE_ECHELON } from '../modele/schemas.ts';

const reseau = construireReseau();

// Repli sans JavaScript et pour les moteurs : le réseau en texte, par échelon.
const parEchelon = reseau.carte.colonnes.map((c) => ({
  libelle: LIBELLE_ECHELON[c.echelon],
  noeuds: reseau.noeuds
    .filter((n) => n.type === 'acteur' && n.echelon === c.echelon)
    .sort((a, b) => a.nom.localeCompare(b.nom, 'fr')),
}));
---

<Base
  titre="La carte des rouages"
  description="Qui décide quoi, avec quel argent, et avec qui — une carte navigable des acteurs publics et de leurs relations, reliée à Wikipédia, Légifrance et l'open data."
  plein
>
  <div class="outils">
    <div class="champ-recherche">
      <label class="visuellement-cache" for="recherche">Chercher un acteur, une compétence</label>
      <input id="recherche" type="search" placeholder="Chercher : eau, collège, préfet…" autocomplete="off" />
      <ul id="resultats"></ul>
    </div>
    <label><input type="checkbox" id="filtre-flux" checked /> Flux d’argent</label>
    <label><input type="checkbox" id="filtre-partage" checked /> Compétences partagées</label>
    <button type="button" class="plat" id="retour-carte" hidden>← Vue d’ensemble</button>
    <span class="zooms">
      <button type="button" class="plat rond" id="zoom-moins" aria-label="Dézoomer">−</button>
      <button type="button" class="plat rond" id="zoom-plus" aria-label="Zoomer">+</button>
      <button type="button" class="plat" id="ajuster">Recadrer</button>
    </span>
  </div>

  <div class="explorateur">
    <div class="scene">
      <svg id="toile" role="application" aria-label="Carte des acteurs publics et de leurs relations"></svg>
      <p class="aide">Cliquez un nœud pour l’ouvrir · glissez pour vous déplacer · Échap pour revenir</p>
    </div>
    <aside id="panneau" aria-live="polite"></aside>
  </div>

  <noscript>
    <div class="page">
      <h1>La carte des rouages</h1>
      <p class="resume">
        La carte interactive demande JavaScript. Voici la même matière, en liste :
        chaque acteur a sa page, avec ses relations et ses liens de référence.
      </p>
      {parEchelon.map((c) => (
        <section>
          <h2>{c.libelle}</h2>
          <ul>{c.noeuds.map((n) => <li><a href={`/n/${n.id}`}>{n.nom}</a> — {n.resume}</li>)}</ul>
        </section>
      ))}
    </div>
  </noscript>

  <script is:inline type="application/json" id="donnees-reseau" set:html={JSON.stringify(reseau)} />
  <script>
    import '../client/explorateur.ts';
  </script>
</Base>
